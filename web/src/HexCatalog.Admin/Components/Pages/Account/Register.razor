@page "/account/register"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject IAuthApiClient Auth
@inject NavigationManager Nav
@inject ILogger<Register> Logger

<PageTitle>Create account · HexCatalog</PageTitle>

<div class="card shadow-sm card-narrow">
    <div class="card-body p-4">
        <h1 class="h4 mb-1">Create an account</h1>
        <p class="text-muted small">An admin approves new accounts before they can see the catalog.</p>

        @if (error is not null)
        {
            <div class="alert alert-danger py-2" role="alert">@error</div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="RegisterAsync" FormName="register">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label" for="register-username">Username</label>
                <InputText id="register-username" class="form-control" @bind-Value="Input.Username" autocomplete="username" />
                <ValidationMessage For="() => Input.Username" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="register-password">Password</label>
                <InputText id="register-password" type="password" class="form-control" @bind-Value="Input.Password" autocomplete="new-password" />
                <div class="form-text">At least 8 characters, with an uppercase letter, a lowercase letter, and a digit.</div>
                <ValidationMessage For="() => Input.Password" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="register-confirm">Confirm password</label>
                <InputText id="register-confirm" type="password" class="form-control" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
                <ValidationMessage For="() => Input.ConfirmPassword" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Create account</button>
        </EditForm>

        <p class="text-center small mt-3 mb-0">
            Already have an account? <a href="account/login">Sign in</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private RegisterInput Input { get; set; } = new();

    private string? error;

    private async Task RegisterAsync()
    {
        AuthResponse auth;
        try
        {
            auth = await Auth.RegisterAsync(new RegisterRequest(Input.Username, Input.Password), HttpContext.RequestAborted);
        }
        catch (ApiException ex)
        {
            error = ex.Describe();
            return;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Catalog API is unreachable");
            error = "The catalog API isn't reachable right now. Try again in a moment.";
            return;
        }

        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            SessionClaims.CreatePrincipal(auth),
            new AuthenticationProperties { ExpiresUtc = auth.ExpiresAt });
        Nav.NavigateTo("");
    }

    private sealed class RegisterInput
    {
        [Required, StringLength(50, MinimumLength = 3)]
        [RegularExpression("^[A-Za-z0-9._-]+$", ErrorMessage = "Use letters, digits, '.', '_' or '-'.")]
        public string Username { get; set; } = "";

        [Required, StringLength(128, MinimumLength = 8)]
        public string Password { get; set; } = "";

        [Required, Compare(nameof(Password), ErrorMessage = "The passwords don't match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
