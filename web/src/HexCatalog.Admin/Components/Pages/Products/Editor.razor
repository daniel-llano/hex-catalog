@page "/products/new"
@page "/products/{Id:guid}/edit"
@attribute [Authorize(Roles = "Admin")]
@inherits ApiComponentBase
@inject IProductService Products

<PageTitle>@Heading · HexCatalog</PageTitle>

<div class="page-title">
    <h1>@Heading</h1>
</div>

@if (Error is not null)
{
    <div class="alert alert-danger">@Error</div>
}

@if (loading)
{
    <p class="text-muted">Loading…</p>
}
else if (product is null)
{
    <p>This product doesn't exist anymore. <a href="products">Back to products</a></p>
}
else
{
    <div class="card shadow-sm" style="max-width: 44rem;">
        <div class="card-body">
            <EditForm Model="product" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="product-name">Name</label>
                    <InputText id="product-name" class="form-control" @bind-Value="product.Name" />
                    <ValidationMessage For="() => product.Name" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="product-description">Description</label>
                    <InputTextArea id="product-description" class="form-control" rows="3" @bind-Value="product.Description" />
                    <ValidationMessage For="() => product.Description" />
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label" for="product-price">Price (USD)</label>
                        <InputNumber id="product-price" class="form-control" step="0.01" @bind-Value="product.Price" />
                        <ValidationMessage For="() => product.Price" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label" for="product-stock">Stock</label>
                        <InputNumber id="product-stock" class="form-control" @bind-Value="product.Stock" />
                        <ValidationMessage For="() => product.Stock" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label" for="product-category">Category</label>
                        <InputText id="product-category" class="form-control" list="category-options" @bind-Value="product.Category" />
                        <datalist id="category-options">
                            @foreach (var c in categories)
                            {
                                <option value="@c"></option>
                            }
                        </datalist>
                        <ValidationMessage For="() => product.Category" />
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@Busy">@(IsNew ? "Create product" : "Save changes")</button>
                    <a href="@(IsNew ? "products" : $"products/{Id}")" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private Product? product;
    private IReadOnlyList<string> categories = [];
    private bool loading = true;

    private bool IsNew => Id is null;
    private string Heading => IsNew ? "New product" : "Edit product";

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        await RunAsync(async () =>
        {
            categories = await Products.GetCategoriesAsync();
            product = IsNew ? new Product() : await Products.GetByIdAsync(Id!.Value);
        });
        loading = false;
    }

    private async Task SaveAsync()
    {
        Product? saved = null;
        var ok = await RunAsync(async () =>
            saved = IsNew ? await Products.CreateAsync(product!) : await Products.UpdateAsync(product!));
        if (ok)
            Nav.NavigateTo($"products/{saved!.Id}");
    }
}
