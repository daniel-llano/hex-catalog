@if (Visible)
{
    <div class="modal-backdrop-custom" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
        <div class="card shadow" style="max-width: 28rem; width: 100%;">
            <div class="card-body">
                <h2 id="confirm-title" class="h5">@Title</h2>
                <div class="mb-3">@ChildContent</div>
                <div class="d-flex justify-content-end gap-2">
                    <button class="btn btn-outline-secondary" @onclick="OnCancel" disabled="@Busy">Cancel</button>
                    <button class="btn @ConfirmClass" @onclick="OnConfirm" disabled="@Busy">@ConfirmText</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string Title { get; set; } = "Are you sure?";
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public string ConfirmClass { get; set; } = "btn-danger";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
